# Copy to .env and edit. Never commit .env. Every value below has a safe development default.

# ---- Environment ----
ENVIRONMENT=development          # development | production (production refuses the default JWT secret and local code execution)
LOG_LEVEL=INFO
LOG_JSON=false

# ---- Database ----
# PostgreSQL is the primary target. SQLite works for a quick try-out (no pgvector, no concurrency guarantees).
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/interview_coach
# DATABASE_URL=sqlite:///./dev.db

# ---- Auth ----
# Generate one:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-this-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ---- AI provider ----
# mock   -> offline deterministic rules (default). Scores are rule-based, NOT a language model; the UI says so.
# openai -> any OpenAI-compatible Chat Completions API
AI_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_TIMEOUT_SECONDS=30
OPENAI_MAX_RETRIES=3

# ---- RAG ----
# hashing              -> lexical hashing vectors, no download (default; NOT semantic)
# sentence-transformers-> real semantic embeddings; pip install -r requirements-ml.txt
EMBEDDING_PROVIDER=hashing
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIM=384
# lexical | cross-encoder
RERANK_PROVIDER=lexical
RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RAG_CHUNK_WORDS=180
RAG_CHUNK_OVERLAP=30

# ---- Uploads ----
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=5
MAX_PHOTO_SIZE_MB=2

# ---- CORS / rate limits ----
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=600
RATE_LIMIT_AUTH_PER_MINUTE=20
RATE_LIMIT_AI_PER_MINUTE=60

# ---- Code execution ----
# docker -> one throw-away container per submission, no network, read-only fs (needs Docker + the sandbox image, see sandbox/Dockerfile)
# local  -> subprocess on this machine. DEVELOPMENT ONLY, not a security boundary. Needs python3, javac and g++ on PATH.
EXECUTION_BACKEND=local
SANDBOX_IMAGE=placement-sandbox:latest
SANDBOX_MEMORY_MB=256
SANDBOX_CPUS=1.0
SANDBOX_PIDS_LIMIT=128
EXEC_TIMEOUT_SECONDS=8
EXEC_COMPILE_TIMEOUT_SECONDS=20
CODE_EXEC_DIR=./code_runs
